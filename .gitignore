# Rust builds; retain Cargo.lock and future suite pins.
target/
/target-*/
/rch_target*/
/remote-target*/
**/*.rs.bk
/rust_out
*.profraw
*.profdata
/coverage/
/criterion/
/bench-output/
/bench-results/
perf.data
perf.data.old
/flamegraph.svg
/flamegraph.folded

# Native build, shader and packaging outputs; keep authored .metal sources.
/build/
/dist/
/DerivedData/
*.dSYM/
*.xcarchive/
*.xcresult/
*.app/
*.air
*.metallib
*.dmg
*.pkg
*.crate

# Local runtime, captures and exports. Keep curated data under tests/fixtures/.
/.fcb/
/captures/
/cache/
/exports/
/qualification-artifacts/
/scratch/
/tmp/
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*.sqlite3
/*.sqlite3-*
/*.log
*.tmp
*.temp
*.swp
*.swo

# Agent-local state. Keep durable Beads JSONL/configuration trackable.
/.ee/
/.ntm/
/.bv/
/.rch/
/.claude/
/.beads/.br_history/
/.beads/*.lock*
/.beads/.*.lock*
/.beads/beads.db*
/.beads/last-touched
/.beads/recovery_*/
/.doctor/

# Secrets and signing material. Do not rely on ignores as a secrets scanner.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# OS/editor metadata.
.DS_Store
._*
.AppleDouble
.LSOverride
.idea/
.vscode/
xcuserdata/
*.xcuserstate
*~
Thumbs.db
Desktop.ini
crates/fcb-conformance/Cargo.lock
